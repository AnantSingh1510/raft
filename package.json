{
  "name": "raft",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time collaborative CRDT engine",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:all": "cargo test && cd server && go test ./... && cd .. && npm test --workspace @raft/sdk"
  }
}
